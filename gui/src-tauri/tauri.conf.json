{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SysInfo",
  "version": "1.0.0",
  "identifier": "com.dz.sysinfo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "SysInfo",
      "width": 1180,
      "height": 760,
      "minWidth": 900,
      "minHeight": 620,
      "resizable": true,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/sys-info-collector.exe"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
